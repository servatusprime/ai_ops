{
  "_comment": "ai_ops global settings template. Apply to ~/.claude/settings.json on new machine onboarding. Replace <workspace-root> with your actual workspace path in additionalDirectories.",
  "_comment_permissions": "Git -C, push/commit/reset/checkout/clean/rm, network and remote Git operations, gh, curl, PowerShell commands, and explicit interpreter/hook-runner command forms use Claude Code ask rules. These prompts are command-text controls, not an OS boundary. The human commit/push gate remains authoritative.",
  "additionalDirectories": [
    "<workspace-root>\\ai_ops\\.claude\\skills",
    "<workspace-root>\\.claude\\skills"
  ],
  "effortLevel": "high",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git check-ignore:*)",
      "Bash(git mv:*)",
      "Bash(git show:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(findstr:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(dir:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(pwd:*)",
      "Bash(echo:*)",
      "Bash(sort:*)",
      "Bash(test:*)",
      "Bash(where:*)"
    ],
    "ask": [
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(py:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pip:*)",
      "Bash(conda:*)",
      "Bash(pre-commit run:*)",
      "Bash(git -C:*)",
      "Bash(git merge:*)",
      "Bash(git stash:*)",
      "Bash(git push:*)",
      "Bash(git -* push:*)",
      "Bash(git commit:*)",
      "Bash(git -* commit:*)",
      "Bash(*git*log --grep=*)",
      "Bash(*git*branch --format=*)",
      "Bash(*git*branch -f*)",
      "Bash(git reset:*)",
      "Bash(git -* reset:*)",
      "Bash(git checkout:*)",
      "Bash(git -* checkout:*)",
      "Bash(git clean:*)",
      "Bash(git -* clean:*)",
      "Bash(git rm:*)",
      "Bash(git -* rm:*)",
      "Bash(git fetch:*)",
      "Bash(git -* fetch:*)",
      "Bash(git pull:*)",
      "Bash(git -* pull:*)",
      "Bash(git clone:*)",
      "Bash(git -* clone:*)",
      "Bash(git ls-remote:*)",
      "Bash(git -* ls-remote:*)",
      "Bash(git submodule:*)",
      "Bash(git -* submodule:*)",
      "Bash(git remote:*)",
      "Bash(git -* remote:*)",
      "Bash(git send-pack:*)",
      "Bash(git -* send-pack:*)",
      "Bash(git receive-pack:*)",
      "Bash(git -* receive-pack:*)",
      "Bash(git upload-pack:*)",
      "Bash(git -* upload-pack:*)",
      "Bash(git http-fetch:*)",
      "Bash(git -* http-fetch:*)",
      "Bash(git http-push:*)",
      "Bash(git -* http-push:*)",
      "Bash(git archive --remote:*)",
      "Bash(git -* archive --remote:*)",
      "Bash(git-remote*:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(powershell:*)",
      "Bash(pwsh:*)",
      "PowerShell"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/credentials*)",
      "Bash(rm -rf:*)",
      "Bash(*--force push*)",
      "Bash(*git push --force*)",
      "Bash(*git push*--delete*)",
      "Bash(*git*commit* --no-verif*)",
      "Bash(*git*commit* -n)",
      "Bash(*git*commit* -n *)",
      "Bash(*git*push* --no-verif*)",
      "Bash(*GIT_CONFIG_*)",
      "Bash(*git*config*--global*)",
      "Bash(*git*update-ref *)",
      "Bash(*git*commit-tree *)",
      "Bash(*git* --output=*)",
      "Bash(*git* --output *)",
      "Bash(*[cC][oO][rR][eE].[hH][oO][oO][kK][sS][pP][aA][tT][hH]*)",
      "Bash(SKIP=*)"
    ]
  }
}
