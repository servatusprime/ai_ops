{
  "_comment": "ai_ops global settings template. Apply to ~/.claude/settings.json on new machine onboarding. Replace <workspace-root> with your actual workspace path in additionalDirectories.",
  "_comment_permissions": "Git -C, push/commit/reset/checkout/clean/rm, network and remote Git operations, gh, curl, and PowerShell commands use Claude Code ask rules. These prompts are command-text controls, not an OS boundary; broadly allowed interpreters and alternate executable spellings remain outside their full control. The human commit/push gate remains authoritative.",
  "additionalDirectories": [
    "<workspace-root>\\ai_ops\\.claude\\skills",
    "<workspace-root>\\.claude\\skills",
    "<workspace-root>\\ai_ops\\.git\\hooks"
  ],
  "effortLevel": "high",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git check-ignore:*)",
      "Bash(git mv:*)",
      "Bash(git stash:*)",
      "Bash(git show:*)",
      "Bash(git merge:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(findstr:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(dir:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(pwd:*)",
      "Bash(echo:*)",
      "Bash(sort:*)",
      "Bash(test:*)",
      "Bash(where:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(py:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pip:*)",
      "Bash(conda:*)",
      "Bash(pre-commit run:*)",
      "Bash(bash .ai_ops/setup/*.sh:*)",
      "Bash(bash ai_ops/.ai_ops/setup/*.sh:*)"
    ],
    "ask": [
      "Bash(git -C:*)",
      "Bash(git push:*)",
      "Bash(git -* push:*)",
      "Bash(git commit:*)",
      "Bash(git -* commit:*)",
      "Bash(git reset:*)",
      "Bash(git -* reset:*)",
      "Bash(git checkout:*)",
      "Bash(git -* checkout:*)",
      "Bash(git clean:*)",
      "Bash(git -* clean:*)",
      "Bash(git rm:*)",
      "Bash(git -* rm:*)",
      "Bash(git fetch:*)",
      "Bash(git -* fetch:*)",
      "Bash(git pull:*)",
      "Bash(git -* pull:*)",
      "Bash(git clone:*)",
      "Bash(git -* clone:*)",
      "Bash(git ls-remote:*)",
      "Bash(git -* ls-remote:*)",
      "Bash(git submodule:*)",
      "Bash(git -* submodule:*)",
      "Bash(git remote:*)",
      "Bash(git -* remote:*)",
      "Bash(git send-pack:*)",
      "Bash(git -* send-pack:*)",
      "Bash(git receive-pack:*)",
      "Bash(git -* receive-pack:*)",
      "Bash(git upload-pack:*)",
      "Bash(git -* upload-pack:*)",
      "Bash(git http-fetch:*)",
      "Bash(git -* http-fetch:*)",
      "Bash(git http-push:*)",
      "Bash(git -* http-push:*)",
      "Bash(git archive --remote:*)",
      "Bash(git -* archive --remote:*)",
      "Bash(git-remote*:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(powershell:*)",
      "Bash(pwsh:*)",
      "PowerShell"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/credentials*)",
      "Bash(rm -rf:*)",
      "Bash(*--force push*)",
      "Bash(*git push --force*)",
      "Bash(*git push*--delete*)"
    ]
  }
}
