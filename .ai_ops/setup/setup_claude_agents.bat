@echo off
REM Setup script for ai_ops native Claude Code subagent definitions
REM (.claude\agents\*.md), generated by 00_Admin\scripts\regenerate_profiles.py.
REM
REM The generator writes canonical definitions to the ai_ops repo tree.
REM External workspace installation is intentionally disabled because this
REM legacy writer has no source-bound preview/approval receipt.

setlocal enableextensions enabledelayedexpansion

REM Capture the script's own location BEFORE the arg-parse loop runs.
REM Plain `shift` shifts %0 along with %1-%9 in Windows batch, so if this
REM block ran after parsing, %~f0 would resolve to whatever the last
REM parsed flag's text was instead of this script's real path (found by
REM round-5 independent review, 2026-09-07; reproduced independently by
REM round-6 review with its own fixture).
set "SCRIPT_DIR="
for %%I in ("%~f0") do set "SCRIPT_DIR=%%~dpI"
for %%I in ("!SCRIPT_DIR!..\..") do set "REPO_ROOT=%%~fI"
set "REPO_AGENTS_DIR=!REPO_ROOT!\.claude\agents"

set "scope=repo"
set "dry_run=0"
set "assume_yes=0"
set "force=0"

:parse_args
if "%~1"=="" goto args_done
if /I "%~1"=="--workspace" (set "scope=workspace" & shift & goto parse_args)
if /I "%~1"=="-w" (set "scope=workspace" & shift & goto parse_args)
if /I "%~1"=="--repo" (set "scope=repo" & shift & goto parse_args)
if /I "%~1"=="-n" (set "dry_run=1" & shift & goto parse_args)
if /I "%~1"=="--dry-run" (set "dry_run=1" & shift & goto parse_args)
if /I "%~1"=="-y" (set "assume_yes=1" & shift & goto parse_args)
if /I "%~1"=="--yes" (set "assume_yes=1" & shift & goto parse_args)
if /I "%~1"=="-f" (set "force=1" & shift & goto parse_args)
if /I "%~1"=="--force" (set "force=1" & shift & goto parse_args)
if /I "%~1"=="-h" goto usage
if /I "%~1"=="--help" goto usage
echo Unknown option: %~1
goto usage_error

:args_done
if /I "!scope!"=="workspace" (
  echo Workspace-scope agent installation is disabled: this legacy writer has no source-bound preview token.
  echo Use a reviewed, preview-token installation path for external agent surfaces.
  endlocal
  exit /b 2
)

where python >nul 2>&1
if errorlevel 1 (
  echo Python is required to run regenerate_profiles.py.
  exit /b 1
)

echo Regenerating native subagent definitions via regenerate_profiles.py...
if "!dry_run!"=="1" (
  python "!REPO_ROOT!\00_Admin\scripts\regenerate_profiles.py" --dry-run
) else (
  python "!REPO_ROOT!\00_Admin\scripts\regenerate_profiles.py"
)
if errorlevel 1 (
  echo Subagent profile generation failed; not proceeding to install.
  exit /b 1
)

echo.
echo Repo-scope install complete. Subagent definitions are at !REPO_AGENTS_DIR!\.
echo ^(and plugins\ai-ops-governance\agents\, tracked in the repo^).

endlocal
exit /b 0

:usage
echo Usage:
echo   .ai_ops\setup\setup_claude_agents.bat [--workspace^|--repo] [--force] [--dry-run] [--yes]
echo.
echo Options:
echo   -w, --workspace        Rejected; use a reviewed preview-token installation path
echo       --repo             Install to ai_ops repo .claude\agents\ only ^(default^)
echo   -f, --force            Retained for CLI compatibility; repo generation is authoritative
echo   -n, --dry-run          Preview actions without writing files
echo   -y, --yes              Non-interactive mode; skip confirmation prompt
echo   -h, --help             Show this help
endlocal
exit /b 0

:usage_error
call :usage
exit /b 1
